{
  "name": "consent-audit",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome MV3 extension auditing cookie banners and privacy policies for GDPR compliance evidence.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "icons": "node scripts/gen-icons.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "build": "node scripts/build.mjs",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test": "npm run check:tokens && npm run test:unit && npm run build && npm run test:e2e",
    "verify:capture": "node scripts/verify-capture.mjs",
    "capture:fixtures": "node scripts/capture-fixtures.mjs",
    "rederive:profiles": "node scripts/rederive-profiles.mjs",
    "verify:banners": "node scripts/verify-banners.mjs",
    "verify:rules": "node scripts/verify-rules.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0"
  }
}
